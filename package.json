{
  "name": "@nicomiguelino/neobrutalist-web-components",
  "version": "0.1.1",
  "description": "Neobrutalist web components (custom elements) for TypeScript and vanilla HTML/CSS/JS apps.",
  "type": "module",
  "license": "MIT",
  "main": "./dist/neobrutalist-web-components.umd.js",
  "module": "./dist/neobrutalist-web-components.es.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "sideEffects": true,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/neobrutalist-web-components.es.js",
      "require": "./dist/neobrutalist-web-components.umd.js"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && tsc -p tsconfig.build.json",
    "preview": "vite preview",
    "prepublishOnly": "npm run build",
    "check": "tsc --noEmit",
    "lint:check": "eslint .",
    "lint:fix": "eslint . --fix",
    "format:check": "prettier --check .",
    "format:fix": "prettier --write .",
    "prepare": "husky"
  },
  "devDependencies": {
    "eslint": "^10.15.0",
    "husky": "^9.1.7",
    "prettier": "^3.10.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.0.1"
  },
  "dependencies": {
    "lit": "^3.3.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nicomiguelino/neobrutalist-web-components.git"
  },
  "homepage": "https://github.com/nicomiguelino/neobrutalist-web-components#readme",
  "bugs": {
    "url": "https://github.com/nicomiguelino/neobrutalist-web-components/issues"
  },
  "overrides": {
    "minimatch": "^11.0.3"
  }
}

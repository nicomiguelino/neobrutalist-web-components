{
  "name": "@nicomiguelino/neobrutalist-web-components",
  "version": "0.1.0",
  "description": "Neobrutalist web components (custom elements) for TypeScript and vanilla HTML/CSS/JS apps.",
  "type": "module",
  "license": "MIT",
  "main": "./dist/neobrutalist-web-components.umd.js",
  "module": "./dist/neobrutalist-web-components.es.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "sideEffects": true,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/neobrutalist-web-components.es.js",
      "require": "./dist/neobrutalist-web-components.umd.js"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && tsc -p tsconfig.build.json",
    "preview": "vite preview"
  },
  "devDependencies": {
    "typescript": "~5.9.3",
    "vite": "^8.0.1"
  },
  "dependencies": {
    "lit": "^3.3.3"
  }
}
